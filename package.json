{
  "name": "wp-elementor-prep",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "AI-free Figma audit and safe-prep engine for WordPress Elementor",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:figma": "node scripts/run-cli.mjs audit:figma",
    "audit:snapshot": "node scripts/run-cli.mjs audit:snapshot",
    "backlog:generate": "node scripts/run-cli.mjs backlog:generate",
    "prepare:figma-import": "node scripts/prepare-figma-import.mjs",
    "runtime:preflight": "node scripts/runtime-artifact-preflight.mjs",
    "runtime:closure-intake": "node scripts/runtime-closure-intake.mjs",
    "integration:readiness": "node scripts/check-integration-readiness.mjs",
    "status:verify": "node scripts/verify-readme-progress.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
