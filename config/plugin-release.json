{
  "schemaVersion": 1,
  "pluginName": "Pella Elementor Prep",
  "editorTypes": ["figma"],
  "networkAccess": {
    "allowedDomains": ["none"]
  },
  "userCommands": [
    { "command": "open", "label": "Open Elementor Prep", "capability": "ui" },
    { "command": "audit", "label": "Audit & Backlog", "capability": "audit-backlog" },
    { "command": "validate", "label": "Compare Two Frames", "capability": "p3-validation" },
    { "command": "export-report", "label": "Audit & Export Report", "capability": "report-export" }
  ],
  "deferredIntegratedCapabilities": [
    { "capability": "safe-fix", "sourceIssue": 6, "releaseGate": 84 },
    { "capability": "advanced-structures", "sourceIssue": 7, "releaseGate": 84 },
    { "capability": "batch-queue", "sourceIssue": 8, "releaseGate": 84 }
  ],
  "developerCommandPolicy": {
    "releaseManifestMayExposeDeveloperCommands": false,
    "reservedPrefixes": ["developer:", "dev-", "p5-", "p6-", "p7-"]
  },
  "releaseFiles": ["manifest.json", "code.js", "ui.html"],
  "provenanceFiles": ["RELEASE_INFO.json", "SHA256SUMS.txt"]
}
